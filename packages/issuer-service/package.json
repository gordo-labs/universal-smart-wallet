{
  "name": "@ssw/issuer-service",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter @ssw/credential-domain build && pnpm --filter @ssw/credential-formats build && pnpm --filter @ssw/issuer-signer build && pnpm --filter @ssw/openid4vc build && pnpm --filter @ssw/trust-registry build && tsc",
    "typecheck": "pnpm build && tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:oid4vci-negative": "pnpm build && node --test --test-name-pattern='OID4VCI negative' test/*.test.mjs"
  },
  "dependencies": {
    "@ssw/credential-domain": "workspace:*",
    "@ssw/credential-formats": "workspace:*",
    "@ssw/issuer-signer": "workspace:*",
    "@ssw/openid4vc": "workspace:*",
    "@ssw/trust-registry": "workspace:*"
  }
}
